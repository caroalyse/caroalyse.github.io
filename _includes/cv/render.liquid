{% assign cv = site.data.cv.cv %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          href="{{ page.cv_pdf | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          aria-label="Download CV as PDF"
          title="Download CV as PDF"
        >
          <i class="fa-solid fa-file-pdf"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% if cv.name or cv.label or cv.location or cv.email %}
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">Contact Information</h3>
          <table class="table table-cv table-sm table-borderless">
            {% if cv.name %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Name</b></td>
                <td class="p-1 pl-2 font-weight-light">{{ cv.name }}</td>
              </tr>
            {% endif %}
            {% if cv.label %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Professional Title</b></td>
                <td class="p-1 pl-2 font-weight-light">{{ cv.label }}</td>
              </tr>
            {% endif %}
            {% if cv.email %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Email</b></td>
                <td class="p-1 pl-2 font-weight-light">
                  <a href="mailto:{{ cv.email }}">{{ cv.email }}</a>
                </td>
              </tr>
            {% endif %}
            {% if cv.location %}
              <tr>
                <td class="p-1 pr-2 font-weight-bold"><b>Location</b></td>
                <td class="p-1 pl-2 font-weight-light">{{ cv.location }}</td>
              </tr>
            {% endif %}
          </table>
        </div>
      {% endif %}

      {% for section_pair in cv.sections %}
        {% assign section_title = section_pair[0] %}
        {% assign entries = section_pair[1] %}
        {% assign first_entry = entries | first %}

        <a class="anchor" id="{{ section_title | slugify }}"></a>
        <div class="card mt-3 p-3">
          <h3 class="card-title font-weight-medium">{{ section_title }}</h3>
          <div>
            {% if section_title == 'Education' %}
              {% include cv/education.liquid %}
            {% elsif section_title == 'Publications' %}
              {% include cv/publications.liquid %}
            {% elsif section_title == 'Languages' %}
              {% include cv/languages.liquid %}
            {% elsif first_entry.company or first_entry.position %}
              {% include cv/experience.liquid %}
            {% elsif first_entry.awarder %}
              {% include cv/awards.liquid %}
            {% elsif first_entry.authors %}
              {% include cv/presentations.liquid %}
            {% elsif first_entry.keywords %}
              {% include cv/competencies.liquid %}
            {% else %}
              <ul class="card-text font-weight-light list-group list-group-flush">
                {% for entry in entries %}
                  <li class="list-group-item">
                    {{ entry.bullet | default: entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </article>
</div>

<style>
  .cv-entry-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cv-entry-item {
    list-style: none;
    margin: 0;
    padding: 1rem 0;
    border-bottom: 1px solid var(--global-divider-color);
  }

  .cv-entry-item:last-child {
    border-bottom: 0;
  }

  .cv-entry-grid {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 3.5fr);
    gap: 1.25rem;
    align-items: start;
  }

  .cv-entry-meta,
  .cv-entry-content {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .cv-entry-meta {
    text-align: center;
  }

  .cv-meta-badge {
    display: inline-block;
    max-width: 100%;
    padding: 0.35rem 0.6rem;
    border-radius: 0.25rem;
    background: var(--global-theme-color);
    color: var(--global-bg-color);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .cv-entry-location {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    line-height: 1.35;
    white-space: normal;
  }

  .cv-entry-title,
  .cv-entry-label {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .cv-entry-title {
    margin: 0 0 0.3rem;
  }

  .cv-entry-subtitle {
    margin-bottom: 0.3rem;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .cv-entry-secondary {
    margin-bottom: 0.35rem;
    font-size: 0.95rem;
    font-style: italic;
  }

  .cv-entry-details,
  .cv-entry-highlights {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .cv-entry-highlights {
    margin-top: 0.5rem;
  }

  @media (max-width: 575px) {
    .cv-entry-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .cv-entry-meta {
      text-align: left;
    }

    .cv-entry-location {
      display: inline;
      margin-left: 0.5rem;
    }
  }
</style>
