<ul class="cv-entry-list card-text font-weight-light">
  {% for entry in entries %}
    <li class="cv-entry-item">
      <div class="cv-entry-grid">
        <div class="cv-entry-meta">
          <span class="cv-entry-label">
            {% if entry.icon %}<i class="{{ entry.icon }}"></i>{% endif %}
            {{ entry.name }}
          </span>
        </div>
        <div class="cv-entry-content cv-entry-details">{{ entry.keywords }}</div>
      </div>
    </li>
  {% endfor %}
</ul>
